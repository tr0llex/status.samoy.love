# Цель: агент, который собирает данные для страницы.

APP=status-agent
ROOT=/opt/status-agent
ARTIFACT_DIR=stage
UNIT=status-agent.service
OWNER=root:status
GOARCH=amd64

# Кавычки ОДИНАРНЫЕ: подстановка должна случиться при сборке, а не при чтении
# этого файла — иначе переменные окажутся пустыми.
# В артефакт кладём и конфиг проверок: он живёт в git рядом с кодом, и
# отдельная копия в /etc неизбежно отстаёт. Так и вышло — правки признаков
# состояния уехали на прод, а конфиг там остался прошлогодний, и половина
# работы была инертна.
# Юниты едут тем же артефактом (deploy-kit, install_units): раньше они
# лежали в git, а на сервер попадали руками, и файл в репозитории с файлом
# на машине расходились молча. Ровно из-за этого агент читал конфиг по
# пути, которого в установленном юните не было.
BUILD_CMD='rm -rf stage && mkdir -p stage/systemd && cd agent && GOOS=linux GOARCH=${DEPLOY_GOARCH:-amd64} CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -o ../stage/status-agent . && cd .. && cp config/status.json stage/status.json && cp deploy/systemd/status-agent.service deploy/systemd/status-agent.timer stage/systemd/'

# Агент — oneshot по таймеру, а не постоянный сервис: HTTP-healthcheck к нему
# неприменим. Что он жив, видно по свежести данных на самой странице.
NEIGHBOURS=status.samoy.love

KEEP=5
WRITE_VERSION_FILE=0

# О РЕЛИЗАХ В ЭТОМ ХОЗЯЙСТВЕ РАССКАЗЫВАЕТ БОТ, А НЕ CI — И БОТ ЖИВЁТ ЗДЕСЬ ЖЕ.
# Полное объяснение — в site.env, здесь коротко: агент есть в config/status.json
# отдельной сборкой (проект «Статус», симлинк /opt/status-agent/current), смену
# его версии бот видит сам и пишет о ней в чат. Уведомление из выкатки было бы
# вторым сообщением об одном событии от того же владельца токена.
NOTIFY=never

# ------------------------------------------------------------ локальный запуск
#
# Ключи RUN_* читает `dk run`. BUILD_CMD выше для этого не годится: в нём
# GOOS=linux GOARCH=amd64, и локально он даёт бинарь под чужую архитектуру.
RUN_DIR=agent
# Кавычки ОДИНАРНЫЕ снаружи и двойные внутри: подставленные пути содержат
# пробел («Alexey Samoylov»), а команду выполняет шелл — без кавычек путь
# разъезжается на два аргумента, и агент падает с «не удалось прочитать
# конфиг C:/Users/Alexey».
RUN_CMD='go run . -config "%DIR%/config/status.json" -data "%MAIN%/data" -metrics ""'

# Агент — oneshot по таймеру и на проде: отработал, записал данные, вышел.
# Раннер его дожидается, а не следит за ним, иначе штатное завершение
# выглядело бы падением и роняло бы за собой страницу.
RUN_ONESHOT=1

# -data ведёт в ОСНОВНОЕ дерево (%MAIN%), а не в текущее (%DIR%). Каталог
# данных — общее состояние: он переживает и выкатку (на проде лежит вне
# releases/), и переключение ветки. Иначе каждый worktree начинал бы историю
# проверок с нуля и первый же запуск страницы показывал бы пустоту.
#
# -metrics пустой: дефолт кода — /var/lib/node_exporter/textfile, серверный
# путь, которого локально нет. Пустое значение означает «не писать», а не
# «писать в никуда».

# ЛОКАЛЬНЫЙ АГЕНТ ХОДИТ ПО ПРОДУ, И ЭТО НЕ ЛЕЧИТСЯ НАСТРОЙКОЙ.
#
# Он проверяет то, что описано в config/status.json, — а там боевые адреса по
# HTTPS. Локально поднятые сервисы он не видит и видеть не должен: страница
# показывает состояние прода, а не вашей машины. Плюс на Windows деградирует
# часть проверок — состояние юнитов он берёт через systemctl, которого нет.
# Всё это не ошибка запуска, поэтому сказано словами, а не спрятано.
RUN_NOTE="агент опрашивает ПРОД по HTTPS: локальные сервисы он не видит, а на Windows проверки юнитов деградируют"
