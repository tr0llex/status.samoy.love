# Цель: статическая страница статуса.

APP=status-site
BUILD_CMD="npm ci && npm run build"
ARTIFACT_DIR=dist

# Данные агента лежат в /var/www/status/data — ВНЕ каталога релизов, поэтому
# выкатка страницы их не трогает и история проверок переживает деплой.
ROOT=/var/www/status
OWNER=ubuntu:ubuntu

NGINX_RELOAD=1

# КОНФИГ NGINX ОПИСЫВАЕТСЯ ПАРОЙ, И ОДНА ПОЛОВИНА НЕ ЗНАЧИТ НИЧЕГО.
#
# NGINX_CONF — что везём, путь ВНУТРИ deploy-kit (конфигурация nginx живёт
# только там, копий в проектах нет). NGINX_DEST — куда класть на сервере.
# Оба пути выкатки — и `dk deploy`, и static-site.yml — трогают конфиг
# ТОЛЬКО когда заданы обе переменные.
#
# Здесь стоял один NGINX_DEST. Пайплайн на это не ругается: обратный случай
# (NGINX_CONF без NGINX_DEST) он валит ошибкой, а этот молча пропускает три
# шага — взять конфиг, проверить его, применить, — и заканчивается зелёным.
# То есть правка status.samoy.love.conf уезжала в deploy-kit, выкатка
# проходила успешно, а на сервере не менялось ничего и никогда.
#
# Перед тем как включить, конфиг сверен с живым сервером (заголовки /, /tg/,
# /_astro/, /data/, /e/ и набор TLS совпадают до строки) и проверен
# `bash ci/nginx-check.sh nginx/sites/status.samoy.love.conf` — синтаксис
# принят nginx 1.24, той же версии, что на проде.
NGINX_CONF=nginx/sites/status.samoy.love.conf
NGINX_DEST=/etc/nginx/sites-available/status.samoy.love.conf

HEALTH=https://status.samoy.love/
VERSION_URL=https://status.samoy.love/version.json

NEIGHBOURS=samoy.love,metro.samoy.love,snakes.samoy.love,launcher.samoy.love,die.samoy.love

KEEP=5

# О РЕЛИЗАХ В ЭТОМ ХОЗЯЙСТВЕ РАССКАЗЫВАЕТ БОТ, А НЕ CI — И БОТ ЖИВЁТ ЗДЕСЬ ЖЕ.
#
# Он раз в минуту читает /version.json каждого сервиса через агента, видит
# смену версии и пишет в чат сам. Поэтому уведомление из выкатки — это второе
# сообщение об одном событии, причём в случае этого репозитория буквально
# дубликат собственного бота.
#
# Прежнее «NOTIFY=all осознанно, статус-страница не следит сама за собой»
# устарело: в config/status.json появился проект «Статус», и в нём все три
# цели — страница по /version.json, агент и бот по симлинку релиза. Молчание
# выкатки теперь не стоит ни одной новости.
#
# Голос обязан быть один и по второй причине: TELEGRAM_* заданы ровно в одном
# репозитории хозяйства. Раздать их остальным — значит получить по два
# сообщения на каждый релиз.
#
# never гасит уведомление ДО обращения к токену (deploy-kit, go-service.yml:
# проверка NOTIFY стоит перед проверкой секретов), поэтому предупреждения
# «токен не задан» тоже не будет.
NOTIFY=never

# ------------------------------------------------------------ локальный запуск
#
# Ключи RUN_* читает `dk run` — локальный двойник выкатки.
RUN_CMD="npm run dev -- --port %PORT%"

# 4331, А НЕ ДЕФОЛТНЫЙ 4321: на нём сидит samoy.love, и обе страницы — Astro.
# Astro при занятом порте не падает, а молча уезжает на соседний, так что при
# запуске обоих сайтов разом статус оказался бы не по своему адресу, и
# выяснилось бы это не сразу. Тот же 4331 стоит в .claude/launch.json.
RUN_PORT=4331

# Страница читает /data/summary.json, и без этих данных она пустая — не
# сломанная, а именно пустая, что читается как «всё упало». Данные собирает
# агент, поэтому он идёт первым; dev-сервер отдаёт каталог data/ заглушкой
# scripts/data-dev-endpoint.mjs — в проде этот путь обслуживает nginx из
# /var/www/status/data, вне каталога релиза.
RUN_NEEDS=status-agent

# отметка замера пайплайнов 2026-09-04
